<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/lakehouse/upload" name="LakehouseUploadAPI" xmlns="http://ws.apache.org/ns/synapse">
    <resource methods="POST" uri-template="/">
        <inSequence>
            <!-- 1. Lưu lại Content-Type gốc (bao gồm boundary) vào thuộc tính tạm -->
            <property expression="$trp:Content-Type" name="OriginalContentType" scope="default" type="STRING"/>
            <!-- 2. Ép gửi Content-Type gốc sang cho backend (đảm bảo giữ được boundary) -->
            <header expression="get-property('OriginalContentType')" name="Content-Type" scope="transport"/>
            <property name="DISABLE_CHUNKING" scope="axis2" type="STRING" value="true"/>
            <property name="COPY_CONTENT_LENGTH_FROM_INCOMING" scope="axis2" type="STRING" value="true"/>
            <property expression="get-property('env', 'LAKE_HOUSE_BASE_URL')" name="uri.var.lake_house_url" scope="default" type="STRING"/>
            <call>
                <endpoint>
                    <http method="post" uri-template="{uri.var.lake_house_url}/api/upload/">
                        <suspendOnFailure>
                            <initialDuration>-1</initialDuration>
                            <progressionFactor>1</progressionFactor>
                        </suspendOnFailure>
                        <markForSuspension>
                            <retriesBeforeSuspension>5</retriesBeforeSuspension>
                        </markForSuspension>
                    </http>
                </endpoint>
            </call>
            <respond/>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <respond/>
        </faultSequence>
    </resource>
</api>
