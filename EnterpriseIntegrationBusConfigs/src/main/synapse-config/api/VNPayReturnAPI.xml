<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/vnpay/return" name="VNPayReturnAPI" xmlns="http://ws.apache.org/ns/synapse">
    <resource methods="GET">
        <inSequence>
            <property expression="get-property('query.param.vnp_TxnRef')" name="uri.var.ref" scope="default" type="STRING"/>
            <property expression="get-property('query.param.vnp_ResponseCode')" name="uri.var.code" scope="default" type="STRING"/>
            <property action="remove" name="REST_URL_POSTFIX" scope="axis2"/>
            <property action="remove" name="NO_ENTITY_BODY" scope="axis2"/>
            <call>
                <endpoint>
                    <http method="get" uri-template="http://localhost:8290/api/v1/webhook/vnpay?vnp_TxnRef={uri.var.ref}&amp;vnp_ResponseCode={uri.var.code}">
                        <suspendOnFailure>
                            <initialDuration>-1</initialDuration>
                            <progressionFactor>1</progressionFactor>
                        </suspendOnFailure>
                        <markForSuspension>
                            <retriesBeforeSuspension>5</retriesBeforeSuspension>
                        </markForSuspension>
                    </http>
                </endpoint>
            </call>
            <property name="HTTP_SC" scope="axis2" type="STRING" value="302"/>
            <header expression="fn:concat('http://localhost:3000/order-result?orderId=', get-property('uri.var.ref'), '&amp;status=success')" name="Location" scope="transport"/>
            <respond/>
        </inSequence>
        <outSequence/>
        <faultSequence/>
    </resource>
</api>
