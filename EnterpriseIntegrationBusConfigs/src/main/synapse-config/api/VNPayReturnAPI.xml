<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/vnpay/return" name="VNPayReturnAPI" xmlns="http://ws.apache.org/ns/synapse">
    <resource methods="GET">
        <inSequence>
            <!-- Nếu khác 00 (Thất bại / Khách hủy) -->
            <!-- Nếu là 00 (Thanh toán thành công) -->
            <property expression="get-property('query.param.vnp_TxnRef')" name="uri.var.ref" scope="default" type="STRING"/>
            <property expression="get-property('query.param.vnp_ResponseCode')" name="uri.var.code" scope="default" type="STRING"/>
            <property action="remove" name="REST_URL_POSTFIX" scope="axis2"/>
            <property action="remove" name="NO_ENTITY_BODY" scope="axis2"/>
            <property expression="get-property('env', 'WSO2_BASE_URL')" name="uri.var.wso2_url" scope="default" type="STRING"/>
            <property expression="get-property('env', 'EXPRESS_APP_BASE_URL')" name="uri.var.express_app_url" scope="default" type="STRING"/>
            <log level="custom">
                <property name="Bước 6" value="Thanh toán thành công, gọi webhook"/>
            </log>
            <call>
                <endpoint>
                    <http method="get" uri-template="{uri.var.wso2_url}/api/v1/webhook/vnpay?vnp_TxnRef={uri.var.ref}&amp;vnp_ResponseCode={uri.var.code}">
                        <suspendOnFailure>
                            <initialDuration>-1</initialDuration>
                            <progressionFactor>1</progressionFactor>
                        </suspendOnFailure>
                        <markForSuspension>
                            <retriesBeforeSuspension>5</retriesBeforeSuspension>
                        </markForSuspension>
                    </http>
                </endpoint>
            </call>
            <!-- Kiểm tra mã vnp_ResponseCode từ VNPay -->
            <filter regex="00" source="get-property('uri.var.code')">
                <then>
                    <property name="FinalStatus" scope="default" type="STRING" value="success"/>
                </then>
                <else>
                    <property name="FinalStatus" scope="default" type="STRING" value="failed"/>
                </else>
            </filter>
            <property name="HTTP_SC" scope="axis2" type="STRING" value="302"/>
            <header expression="fn:concat(get-property('uri.var.express_app_url'), '/order-result?orderId=', get-property('uri.var.ref'), '&amp;status=', get-property('FinalStatus'))" name="Location" scope="transport"/>
            <respond/>
        </inSequence>
        <outSequence/>
        <faultSequence/>
    </resource>
</api>
