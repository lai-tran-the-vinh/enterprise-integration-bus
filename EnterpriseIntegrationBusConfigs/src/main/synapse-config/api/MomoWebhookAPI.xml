<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/webhook" name="MomoWebhookAPI" xmlns="http://ws.apache.org/ns/synapse">
    <resource methods="POST" uri-template="/momo">
        <inSequence>
            <property expression="json-eval($.orderId)" name="uri.var.orderid" scope="default" type="STRING"/>
            <property expression="json-eval($.orderId)" name="DolibarrOrderID" scope="default" type="STRING"/>
            <property expression="json-eval($.resultCode)" name="ResultCode" scope="default" type="STRING"/>
            <filter regex="^0$" source="get-property('ResultCode')">
                <then>
                    <property name="DOLAPIKEY" scope="transport" type="STRING" value="59352f3754484dc66e9fae32e834ce40c2ea218e"/>
                    <call>
                        <endpoint>
                            <http method="get" uri-template="http://localhost:8000/api/index.php/orders/{uri.var.orderid}">
                                <suspendOnFailure>
                                    <initialDuration>-1</initialDuration>
                                    <progressionFactor>1</progressionFactor>
                                </suspendOnFailure>
                                <markForSuspension>
                                    <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                </markForSuspension>
                            </http>
                        </endpoint>
                    </call>
                    <property expression="json-eval($.socid)" name="uri.var.socid" scope="default" type="STRING"/>
                    <enrich>
                        <source clone="true" type="body"/>
                        <target property="DolibarrOrder" type="property"/>
                    </enrich>
                    <property name="DOLAPIKEY" scope="transport" type="STRING" value="59352f3754484dc66e9fae32e834ce40c2ea218e"/>
                    <call>
                        <endpoint>
                            <http method="get" uri-template="http://localhost:8000/api/index.php/thirdparties/{uri.var.socid}">
                                <suspendOnFailure>
                                    <initialDuration>-1</initialDuration>
                                    <progressionFactor>1</progressionFactor>
                                </suspendOnFailure>
                                <markForSuspension>
                                    <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                </markForSuspension>
                            </http>
                        </endpoint>
                    </call>
                    <property expression="json-eval($.name)" name="CustomerName" scope="default" type="STRING"/>
                    <property expression="json-eval($.email)" name="CustomerEmail" scope="default" type="STRING"/>
                    <payloadFactory media-type="json">
                        <format>
							{
							"username": "tvinh9130@gmail.com",
							"password": "$The-Vinh-2004$",
							"device_name": "wso2-webhook"
							}
						</format>
                        <args/>
                    </payloadFactory>
                    <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
                    <call>
                        <endpoint>
                            <http method="post" uri-template="http://localhost:8002/api/v1/auth/login">
                                <suspendOnFailure>
                                    <initialDuration>-1</initialDuration>
                                    <progressionFactor>1</progressionFactor>
                                </suspendOnFailure>
                                <markForSuspension>
                                    <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                </markForSuspension>
                            </http>
                        </endpoint>
                    </call>
                    <property expression="json-eval($.token)" name="ISToken" scope="default" type="STRING"/>
                    <property expression="get-property('CustomerEmail')" name="uri.var.custEmail" scope="default" type="STRING"/>
                    <header expression="fn:concat('Bearer ', get-property('ISToken'))" name="Authorization" scope="transport"/>
                    <property name="company" scope="transport" type="STRING" value="1"/>
                    <call>
                        <endpoint>
                            <http method="get" uri-template="http://localhost:8002/api/v1/customers?filter[email]={uri.var.custEmail}">
                                <suspendOnFailure>
                                    <initialDuration>-1</initialDuration>
                                    <progressionFactor>1</progressionFactor>
                                </suspendOnFailure>
                                <markForSuspension>
                                    <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                </markForSuspension>
                            </http>
                        </endpoint>
                    </call>
                    <script language="js"><![CDATA[var result = mc.getPayloadJSON();
                        var isCustomerId = "";
                        if (result && result.data && result.data.length > 0) {
                            isCustomerId = String(result.data[0].id);
                        }
                        mc.setProperty("ISCustomerId", isCustomerId);]]></script>
                    <filter regex="^$" source="get-property('ISCustomerId')">
                        <then>
                            <payloadFactory media-type="json">
                                <format>
									{ "name": "$1", "email": "$2" }
								</format>
                                <args>
                                    <arg evaluator="xml" expression="get-property('CustomerName')"/>
                                    <arg evaluator="xml" expression="get-property('CustomerEmail')"/>
                                </args>
                            </payloadFactory>
                            <header expression="fn:concat('Bearer ', get-property('ISToken'))" name="Authorization" scope="transport"/>
                            <property name="company" scope="transport" type="STRING" value="1"/>
                            <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
                            <call>
                                <endpoint>
                                    <http method="post" uri-template="http://localhost:8002/api/v1/customers">
                                        <suspendOnFailure>
                                            <initialDuration>-1</initialDuration>
                                            <progressionFactor>1</progressionFactor>
                                        </suspendOnFailure>
                                        <markForSuspension>
                                            <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                        </markForSuspension>
                                    </http>
                                </endpoint>
                            </call>
                            <property expression="json-eval($.data.id)" name="ISCustomerId" scope="default" type="STRING"/>
                        </then>
                        <else/>
                    </filter>
                    <enrich>
                        <source clone="true" property="DolibarrOrder" type="property"/>
                        <target type="body"/>
                    </enrich>
                    <script language="js"><![CDATA[var order = mc.getPayloadJSON();
                        var items = [];
                        var subTotal = 0;

                        var d = new Date();
                        var todayStr = d.getFullYear() + "-" + ("0"+(d.getMonth()+1)).slice(-2) + "-" + ("0"+d.getDate()).slice(-2);

                        if (order.lines) {
                            for (var i = 0; i < order.lines.length; i++) {
                                var line = order.lines[i];
                                var lineTotal = parseFloat(line.subprice) * parseInt(line.qty);
                                subTotal += lineTotal;
                                
                                var itemName = line.product_label || line.label || line.desc || ("Sản phẩm ID " + line.fk_product);
                                
                                items.push({
                                    "name": itemName,
                                    "quantity": parseInt(line.qty),
                                    "price": parseFloat(line.subprice),
                                    "discount": 0,
                                    "discount_type": "fixed",
                                    "discount_val": 0,
                                    "tax": 0,
                                    "total": lineTotal
                                });
                            }
                        }

                        var invoicePayload = {
                            "invoice_number": "INV-DL-" + mc.getProperty("DolibarrOrderID"),
                            "template_name": "invoice1",
                            "customer_id": parseInt(mc.getProperty("ISCustomerId")),
                            "invoice_date": todayStr,
                            "due_date": todayStr,
                            "sub_total": subTotal,
                            "discount": 0,
                            "discount_val": 0,
                            "tax": 0,
                            "total": subTotal,
                            "items": items
                        };
                        mc.setPayloadJSON(invoicePayload);]]></script>
                    <header expression="fn:concat('Bearer ', get-property('ISToken'))" name="Authorization" scope="transport"/>
                    <property name="company" scope="transport" type="STRING" value="1"/>
                    <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
                    <call>
                        <endpoint>
                            <http method="post" uri-template="http://localhost:8002/api/v1/invoices">
                                <suspendOnFailure>
                                    <initialDuration>-1</initialDuration>
                                    <progressionFactor>1</progressionFactor>
                                </suspendOnFailure>
                                <markForSuspension>
                                    <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                </markForSuspension>
                            </http>
                        </endpoint>
                    </call>
                    <property expression="json-eval($.data.id)" name="ISInvoiceId" scope="default" type="STRING"/>
                    <property expression="json-eval($.data.total)" name="ISInvoiceTotal" scope="default" type="STRING"/>
                    <property expression="get-property('SYSTEM_DATE', 'yyyy-MM-dd')" name="PaymentDate" scope="default" type="STRING"/>
                    <payloadFactory media-type="json">
                        <format>
							{
							"customer_id": $1,
							"payment_number": "PAY-$2",
							"invoice_id": $2,
							"amount": $3,
							"payment_date": "$4"
							}
						</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('ISCustomerId')"/>
                            <arg evaluator="xml" expression="get-property('ISInvoiceId')"/>
                            <arg evaluator="xml" expression="get-property('ISInvoiceTotal')"/>
                            <arg evaluator="xml" expression="get-property('PaymentDate')"/>
                        </args>
                    </payloadFactory>
                    <header expression="fn:concat('Bearer ', get-property('ISToken'))" name="Authorization" scope="transport"/>
                    <property name="company" scope="transport" type="STRING" value="1"/>
                    <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
                    <call>
                        <endpoint>
                            <http method="post" uri-template="http://localhost:8002/api/v1/payments">
                                <suspendOnFailure>
                                    <initialDuration>-1</initialDuration>
                                    <progressionFactor>1</progressionFactor>
                                </suspendOnFailure>
                                <markForSuspension>
                                    <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                </markForSuspension>
                            </http>
                        </endpoint>
                    </call>
                    <!-- ĐÃ SỬA BƯỚC 10 TẠI ĐÂY: Xóa header lạ và chỉ gửi đúng JSON chứa 
						ref_ext -->
                    <header action="remove" name="Authorization" scope="transport"/>
                    <property action="remove" name="company" scope="transport"/>
                    <property name="DOLAPIKEY" scope="transport" type="STRING" value="59352f3754484dc66e9fae32e834ce40c2ea218e"/>
                    <payloadFactory media-type="json">
                        <format>
							{ "ref_ext": "INV-DL-$1" }
						</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('DolibarrOrderID')"/>
                        </args>
                    </payloadFactory>
                    <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
                    <call>
                        <endpoint>
                            <http method="put" uri-template="http://localhost:8000/api/index.php/orders/{uri.var.orderid}">
                                <suspendOnFailure>
                                    <initialDuration>-1</initialDuration>
                                    <progressionFactor>1</progressionFactor>
                                </suspendOnFailure>
                                <markForSuspension>
                                    <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                </markForSuspension>
                            </http>
                        </endpoint>
                    </call>
                    <property name="DOLAPIKEY" scope="transport" type="STRING" value="59352f3754484dc66e9fae32e834ce40c2ea218e"/>
                    <property action="remove" name="Authorization" scope="transport"/>
                    <payloadFactory media-type="json">
                        <format>
							{ "notrigger": 0 }
						</format>
                        <args/>
                    </payloadFactory>
                    <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
                    <call>
                        <endpoint>
                            <http method="post" uri-template="http://localhost:8000/api/index.php/orders/{uri.var.orderid}/close">
                                <suspendOnFailure>
                                    <initialDuration>-1</initialDuration>
                                    <progressionFactor>1</progressionFactor>
                                </suspendOnFailure>
                                <markForSuspension>
                                    <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                </markForSuspension>
                            </http>
                        </endpoint>
                    </call>
                    <payloadFactory media-type="json">
                        <format>
							{"status": "received"}
						</format>
                        <args/>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" type="STRING" value="200"/>
                    <respond/>
                </then>
                <else>
                    <payloadFactory media-type="json">
                        <format>
							{"status": "ignored", "reason": "payment not successful"}</format>
                        <args/>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" type="STRING" value="200"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <payloadFactory media-type="json">
                <format>
					{"error": "Internal Server Error", "details": "$1"}
				</format>
                <args>
                    <arg evaluator="xml" expression="get-property('ERROR_MESSAGE')"/>
                </args>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" type="STRING" value="500"/>
            <respond/>
        </faultSequence>
    </resource>
</api>
