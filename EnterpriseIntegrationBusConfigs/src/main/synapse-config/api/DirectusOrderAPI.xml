<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/orders" name="DirectusOrderAPI" xmlns="http://ws.apache.org/ns/synapse">
    <resource methods="POST" uri-template="/">
        <inSequence>
            <property expression="$trp:Authorization" name="AuthHeader" scope="default" type="STRING"/>
            <enrich>
                <source clone="true" type="body"/>
                <target property="DirectusOriginalPayload" type="property"/>
            </enrich>
            <filter regex="^Bearer .+" source="get-property('AuthHeader')">
                <then>
                    <property expression="fn:substring-after(get-property('AuthHeader'), 'Bearer ')" name="BearerToken" scope="default" type="STRING"/>
                    <header action="remove" name="Authorization" scope="transport"/>
                    <payloadFactory media-type="xml">
                        <format>
                            <xform>
                                <token>$1</token>
                                <client_id>wso2-client</client_id>
                                <client_secret>QWE3InQrvUYb7MTCZXL2aRhHCR894zTL</client_secret>
                            </xform>
                        </format>
                        <args>
                            <arg evaluator="xml" expression="get-property('BearerToken')"/>
                        </args>
                    </payloadFactory>
                    <property name="messageType" scope="axis2" type="STRING" value="application/x-www-form-urlencoded"/>
                    <call>
                        <endpoint>
                            <http method="post" uri-template="http://localhost:8080/realms/WSO2-Realm/protocol/openid-connect/token/introspect">
                                <suspendOnFailure>
                                    <initialDuration>-1</initialDuration>
                                    <progressionFactor>1</progressionFactor>
                                </suspendOnFailure>
                                <markForSuspension>
                                    <retriesBeforeSuspension>0</retriesBeforeSuspension>
                                </markForSuspension>
                            </http>
                        </endpoint>
                    </call>
                    <filter regex="true" source="json-eval($.active)">
                        <then>
                            <enrich>
                                <source clone="true" property="DirectusOriginalPayload" type="property"/>
                                <target type="body"/>
                            </enrich>
                            <property expression="fn:substring(get-property('SYSTEM_TIME'), 1, 10)" name="EpochSeconds" scope="default" type="STRING"/>
                            <script language="js"><![CDATA[var payload = mc.getPayloadJSON();
                                var dateSec = mc.getProperty("EpochSeconds");
                                
                                // Khởi tạo vỏ đơn hàng
                                var dolibarrPayload = {
                                    "socid": 1,
                                    "date": parseInt(dateSec),
                                    "type": 0,
                                    "lines": []
                                };
                                
                                // Lặp mảng đẩy thẳng vào lines của Dolibarr
                                if (payload.products && payload.products.length > 0) {
                                    for (var i = 0; i < payload.products.length; i++) {
                                        dolibarrPayload.lines.push({
                                            "fk_product": payload.products[i].product_id,
                                            "qty": payload.products[i].quantity,
                                            "subprice": payload.products[i].unit_price,
                                            "product_type": 0
                                        });
                                    }
                                }
                                
                                // Ép WSO2 nhận cục JSON mới này làm Body
                                mc.setPayloadJSON(dolibarrPayload);]]></script>
                            <property name="DOLAPIKEY" scope="transport" type="STRING" value="59352f3754484dc66e9fae32e834ce40c2ea218e"/>
                            <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
                            <call>
                                <endpoint>
                                    <http method="post" uri-template="http://localhost:8000/api/index.php/orders">
                                        <suspendOnFailure>
                                            <initialDuration>-1</initialDuration>
                                            <progressionFactor>1</progressionFactor>
                                        </suspendOnFailure>
                                        <markForSuspension>
                                            <retriesBeforeSuspension>0</retriesBeforeSuspension>
                                        </markForSuspension>
                                    </http>
                                </endpoint>
                            </call>
                            <property expression="fn:normalize-space($body//text())" name="DolibarrOrderID" scope="default" type="STRING"/>
                            <property expression="get-property('DolibarrOrderID')" name="uri.var.orderid" scope="default" type="STRING"/>
                            <filter regex="^[0-9]+$" source="get-property('DolibarrOrderID')">
                                <then>
                                    <payloadFactory media-type="json">
                                        <format>
											{}
										</format>
                                        <args/>
                                    </payloadFactory>
                                    <property name="DOLAPIKEY" scope="transport" type="STRING" value="59352f3754484dc66e9fae32e834ce40c2ea218e"/>
                                    <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
                                    <call>
                                        <endpoint>
                                            <http method="post" uri-template="http://localhost:8000/api/index.php/orders/{uri.var.orderid}/validate">
                                                <suspendOnFailure>
                                                    <initialDuration>-1</initialDuration>
                                                    <progressionFactor>1</progressionFactor>
                                                </suspendOnFailure>
                                                <markForSuspension>
                                                    <retriesBeforeSuspension>0</retriesBeforeSuspension>
                                                </markForSuspension>
                                            </http>
                                        </endpoint>
                                    </call>
                                    <payloadFactory media-type="json">
                                        <format>
											{
											"status": "success",
											"message": "Order created with all
											products perfectly!",
											"dolibarr_order_id": $1
											}
										</format>
                                        <args>
                                            <arg evaluator="xml" expression="get-property('DolibarrOrderID')"/>
                                        </args>
                                    </payloadFactory>
                                    <property name="HTTP_SC" scope="axis2" type="STRING" value="200"/>
                                    <respond/>
                                </then>
                                <else>
                                    <payloadFactory media-type="json">
                                        <format>
											{"error": "Failed to create order in Dolibarr", "details":
											"$1"}
										</format>
                                        <args>
                                            <arg evaluator="xml" expression="get-property('DolibarrOrderID')"/>
                                        </args>
                                    </payloadFactory>
                                    <property name="HTTP_SC" scope="axis2" type="STRING" value="500"/>
                                    <respond/>
                                </else>
                            </filter>
                        </then>
                        <else>
                            <payloadFactory media-type="json">
                                <format>
									{"error": "Unauthorized", "message": "Invalid or expired
									token"}
								</format>
                                <args/>
                            </payloadFactory>
                            <property name="HTTP_SC" scope="axis2" type="STRING" value="401"/>
                            <respond/>
                        </else>
                    </filter>
                </then>
                <else>
                    <payloadFactory media-type="json">
                        <format>
							{"error": "Unauthorized", "message": "Missing Authorization
							header"}
						</format>
                        <args/>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" type="STRING" value="401"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <payloadFactory media-type="json">
                <format>
					{"error": "Internal Server Error", "details": "$1"}
				</format>
                <args>
                    <arg evaluator="xml" expression="get-property('ERROR_MESSAGE')"/>
                </args>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" type="STRING" value="500"/>
            <respond/>
        </faultSequence>
    </resource>
</api>
