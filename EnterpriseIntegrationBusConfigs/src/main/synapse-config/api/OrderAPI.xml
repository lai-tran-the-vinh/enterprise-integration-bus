<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/orders" name="OrderAPI" xmlns="http://ws.apache.org/ns/synapse">
    <resource methods="POST" uri-template="/">
        <inSequence>
            <property expression="json-eval($.customer_name)" name="CustomerName" scope="default" type="STRING"/>
            <property expression="json-eval($.customer_email)" name="CustomerEmail" scope="default" type="STRING"/>
            <property expression="json-eval($.amount)" name="OrderAmount" scope="default" type="STRING"/>
            <property expression="$trp:Authorization" name="AuthHeader" scope="default" type="STRING"/>
            <log level="custom">
                <property name="Bước 1" value="Nhận yêu cầu từ trang bán hàng"/>
            </log>
            <enrich>
                <source clone="true" type="body"/>
                <target property="DirectusOriginalPayload" type="property"/>
            </enrich>
            <property expression="get-property('env', 'KEYCLOAK_CLIENT_SECRET')" name="KEYCLOAK_CLIENT_SECRET" scope="default" type="STRING"/>
            <property expression="get-property('env', 'DOLIBARR_TOKEN')" name="DOLIBARR_TOKEN" scope="default" type="STRING"/>
            <!-- Đây phải không? -->
            <property expression="get-property('env', 'KEYCLOAK_BASE_URL')" name="uri.var.keycloak_url" scope="default" type="STRING"/>
            <property expression="get-property('env', 'DOLIBARR_BASE_URL')" name="uri.var.dolibarr_url" scope="default" type="STRING"/>
            <property expression="get-property('env', 'WSO2_BASE_URL')" name="uri.var.wso2_url" scope="default" type="STRING"/>
            <filter regex="^Bearer .+" source="get-property('AuthHeader')">
                <then>
                    <property expression="fn:substring-after(get-property('AuthHeader'), 'Bearer ')" name="BearerToken" scope="default" type="STRING"/>
                    <header action="remove" name="Authorization" scope="transport"/>
                    <payloadFactory media-type="xml">
                        <format>
                            <xform>
                                <token>$1</token>
                                <client_id>wso2-client</client_id>
                                <client_secret>$2</client_secret>
                            </xform>
                        </format>
                        <args>
                            <arg evaluator="xml" expression="get-property('BearerToken')"/>
                            <arg evaluator="xml" expression="get-property('env', 'KEYCLOAK_CLIENT_SECRET')"/>
                        </args>
                    </payloadFactory>
                    <log level="custom">
                        <property name="Bước 2" value="Xác thực token Keycloak"/>
                    </log>
                    <property name="messageType" scope="axis2" type="STRING" value="application/x-www-form-urlencoded"/>
                    <property name="DISABLE_CHUNKING" scope="axis2" type="STRING" value="true"/>
                    <property action="remove" name="REST_URL_POSTFIX" scope="axis2"/>
                    <!-- <call>
                        <endpoint>
                            <http method="post" uri-template="{uri.var.keycloak_url}/realms/WSO2-Realm/protocol/openid-connect/token/introspect">
                                <suspendOnFailure>
                                    <initialDuration>-1</initialDuration>
                                    <progressionFactor>1</progressionFactor>
                                </suspendOnFailure>
                                <markForSuspension>
                                    <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                </markForSuspension>
                            </http>
                        </endpoint>
                    </call> -->
                    <!-- Tạm thời bỏ qua Keycloak, ép cứng kết quả trả về là active: true -->
                    <payloadFactory media-type="json">
                        <format>
					        {"active": true}
					    </format>
                        <args/>
                    </payloadFactory>
                    <filter regex="true" source="json-eval($.active)">
                        <then>
                            <property expression="get-property('env', 'DOLIBARR_TOKEN')" name="DOLAPIKEY" scope="transport" type="STRING"/>
                            <call>
                                <endpoint>
                                    <http method="get" uri-template="{uri.var.dolibarr_url}/api/index.php/products?limit=100">
                                        <suspendOnFailure>
                                            <initialDuration>-1</initialDuration>
                                            <progressionFactor>1</progressionFactor>
                                        </suspendOnFailure>
                                        <markForSuspension>
                                            <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                        </markForSuspension>
                                    </http>
                                </endpoint>
                            </call>
                            <script language="js"><![CDATA[var products = mc.getPayloadJSON();
								for (var p = 0; p < products.length; p++) {
								    mc.setProperty("Price_" + products[p].id, products[p].price);
								}]]></script>
                            <!-- 2. Tra cứu khách hàng theo email -->
                            <property expression="get-property('CustomerEmail')" name="uri.var.custEmail" scope="default" type="STRING"/>
                            <property expression="get-property('env', 'DOLIBARR_TOKEN')" name="DOLAPIKEY" scope="transport" type="STRING"/>
                            <call>
                                <endpoint>
                                    <http method="get" uri-template="{uri.var.dolibarr_url}/api/index.php/thirdparties?sqlfilters=(t.email:=:'{uri.var.custEmail}')">
                                        <suspendOnFailure>
                                            <initialDuration>-1</initialDuration>
                                            <progressionFactor>1</progressionFactor>
                                        </suspendOnFailure>
                                        <markForSuspension>
                                            <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                        </markForSuspension>
                                    </http>
                                </endpoint>
                            </call>
                            <script language="js"><![CDATA[var result = mc.getPayloadJSON();
								var socId = "";
								if (result && result.length && result.length > 0 && result[0].id) {
								    socId = result[0].id;
								}
								mc.setProperty("CustomerSocId", socId);]]></script>
                            <!-- 3. Nếu chưa có khách hàng (socId rỗng) -> tạo mới -->
                            <filter regex="^$" source="get-property('CustomerSocId')">
                                <then>
                                    <payloadFactory media-type="json">
                                        <format>
											{
												"name": "$1",
												"email": "$2",
												"client": 1
											}
										</format>
                                        <args>
                                            <arg evaluator="xml" expression="get-property('CustomerName')"/>
                                            <arg evaluator="xml" expression="get-property('CustomerEmail')"/>
                                        </args>
                                    </payloadFactory>
                                    <property expression="get-property('env', 'DOLIBARR_TOKEN')" name="DOLAPIKEY" scope="transport" type="STRING"/>
                                    <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
                                    <call>
                                        <endpoint>
                                            <http method="post" uri-template="{uri.var.dolibarr_url}/api/index.php/thirdparties">
                                                <suspendOnFailure>
                                                    <initialDuration>-1</initialDuration>
                                                    <progressionFactor>1</progressionFactor>
                                                </suspendOnFailure>
                                                <markForSuspension>
                                                    <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                                </markForSuspension>
                                            </http>
                                        </endpoint>
                                    </call>
                                    <property expression="fn:normalize-space($body//text())" name="CustomerSocId" scope="default" type="STRING"/>
                                </then>
                                <else/>
                            </filter>
                            <!-- 4. Khôi phục payload gốc để đọc products -->
                            <enrich>
                                <source clone="true" property="DirectusOriginalPayload" type="property"/>
                                <target type="body"/>
                            </enrich>
                            <property expression="fn:substring(get-property('SYSTEM_TIME'), 1, 10)" name="EpochSeconds" scope="default" type="STRING"/>
                            <script language="js"><![CDATA[var payload = mc.getPayloadJSON();
                                var dateSec = mc.getProperty("EpochSeconds");

                                var dolibarrPayload = {
                                    "socid": parseInt(mc.getProperty("CustomerSocId")),
                                    "date": parseInt(dateSec),
                                    "type": 0,
                                    "lines": []
                                };

                                if (payload.products && payload.products.length > 0) {
                                    for (var i = 0; i < payload.products.length; i++) {
                                        dolibarrPayload.lines.push({
                                            "fk_product": payload.products[i].product_id,
                                            "qty": payload.products[i].quantity,
                                            "subprice": mc.getProperty("Price_" + payload.products[i].product_id),
                                            "tva_tx": 0,
                                            "product_type": 0
                                        });
                                    }
                                }

                                mc.setPayloadJSON(dolibarrPayload);]]></script>
                            <log level="custom">
                                <property name="Bước 3" value="Tạo đơn hàng trên Dolibarr"/>
                            </log>
                            <property expression="get-property('env', 'DOLIBARR_TOKEN')" name="DOLAPIKEY" scope="transport" type="STRING"/>
                            <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
                            <call>
                                <endpoint>
                                    <http method="post" uri-template="{uri.var.dolibarr_url}/api/index.php/orders">
                                        <suspendOnFailure>
                                            <initialDuration>-1</initialDuration>
                                            <progressionFactor>1</progressionFactor>
                                        </suspendOnFailure>
                                        <markForSuspension>
                                            <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                        </markForSuspension>
                                    </http>
                                </endpoint>
                            </call>
                            <property expression="fn:normalize-space($body//text())" name="DolibarrOrderID" scope="default" type="STRING"/>
                            <property expression="get-property('DolibarrOrderID')" name="uri.var.orderid" scope="default" type="STRING"/>
                            <log level="custom">
                                <property name="Bước 4" value="Gọi sang cổng thanh toán"/>
                            </log>
                            <filter regex="^[0-9]+$" source="get-property('DolibarrOrderID')">
                                <then>
                                    <payloadFactory media-type="json">
                                        <format>
											{
												"orderId": "$1",
												"amount": "$2",
												"orderInfo": "Thanh toan don hang $1",
												"redirectUrl": "$3/api/v1/vnpay/return"
											}
										</format>
                                        <args>
                                            <arg evaluator="xml" expression="get-property('DolibarrOrderID')"/>
                                            <arg evaluator="xml" expression="get-property('OrderAmount')"/>
                                            <arg evaluator="xml" expression="get-property('uri.var.wso2_url')"/>
                                        </args>
                                    </payloadFactory>
                                    <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
                                    <call>
                                        <endpoint>
                                            <http method="post" uri-template="{uri.var.wso2_url}/api/v1/payments/vnpay">
                                                <suspendOnFailure>
                                                    <initialDuration>-1</initialDuration>
                                                    <progressionFactor>1</progressionFactor>
                                                </suspendOnFailure>
                                                <markForSuspension>
                                                    <retriesBeforeSuspension>5</retriesBeforeSuspension>
                                                </markForSuspension>
                                            </http>
                                        </endpoint>
                                    </call>
                                    <property expression="json-eval($.payUrl)" name="VNPayPayURL" scope="default" type="STRING"/>
                                    <filter regex="^.+$" source="get-property('VNPayPayURL')">
                                        <then>
                                            <payloadFactory media-type="json">
                                                <format>
													{
														"status": "success",
														"message": "Đã tạo đơn hàng và link thanh toán thành công.",
														"dolibarr_order_id": "$1",
														"payment_url": "$2"
													}
												</format>
                                                <args>
                                                    <arg evaluator="xml" expression="get-property('DolibarrOrderID')"/>
                                                    <arg evaluator="xml" expression="get-property('VNPayPayURL')"/>
                                                </args>
                                            </payloadFactory>
                                            <respond/>
                                        </then>
                                        <else>
                                            <payloadFactory media-type="json">
                                                <format>
													{
													"status": "error",
													"message": "Không thể tạo link thanh toán VNPay. Vui lòng thử lại sau."
													}
							</format>
                                                <args/>
                                            </payloadFactory>
                                            <property name="HTTP_SC" scope="axis2" type="STRING" value="500"/>
                                            <respond/>
                                        </else>
                                    </filter>
                                </then>
                                <else>
                                    <payloadFactory media-type="json">
                                        <format>
											{"error": "Failed to create order in Dolibarr", "details": "$1"}</format>
                                        <args>
                                            <arg evaluator="xml" expression="get-property('DolibarrOrderID')"/>
                                        </args>
                                    </payloadFactory>
                                    <property name="HTTP_SC" scope="axis2" type="STRING" value="500"/>
                                    <respond/>
                                </else>
                            </filter>
                        </then>
                        <else>
                            <payloadFactory media-type="json">
                                <format>
									{"error": "Unauthorized", "message": "Invalid or expired token"}</format>
                                <args/>
                            </payloadFactory>
                            <property name="HTTP_SC" scope="axis2" type="STRING" value="401"/>
                            <respond/>
                        </else>
                    </filter>
                </then>
                <else>
                    <payloadFactory media-type="json">
                        <format>
							{"error": "Unauthorized", "message": "Missing Authorization header"}</format>
                        <args/>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" type="STRING" value="401"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <payloadFactory media-type="json">
                <format>
					{"error": "Internal Server Error", "details": "$1"}
				</format>
                <args>
                    <arg evaluator="xml" expression="get-property('ERROR_MESSAGE')"/>
                </args>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" type="STRING" value="500"/>
            <respond/>
        </faultSequence>
    </resource>
</api>
